class Solution(object):
    def convertToBase7(self, num):
        """
        :type num: int
        :rtype: str
        """
        if num == 0:
            return "0"

        negative = num < 0
        num = abs(num)

        ans = []

        while num:
            ans.append(str(num % 7))
            num //= 7

        if negative:
            ans.append('-')

        return ''.join(ans[::-1])
