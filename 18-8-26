class Solution(object):
    def largestAlmostMissing(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        count = [0] * 51

        n = len(nums)

        # Check every subarray of size k
        for i in range(n - k + 1):
            seen = set()

            for j in range(i, i + k):
                seen.add(nums[j])

            # Count this subarray only once for each value
            for x in seen:
                count[x] += 1

        # Find the largest number appearing in exactly one
        # subarray of size k
        for x in range(50, -1, -1):
            if count[x] == 1:
                return x

        return -1
