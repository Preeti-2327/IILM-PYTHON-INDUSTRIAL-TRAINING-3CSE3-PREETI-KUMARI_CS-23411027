class Solution(object):
    def gcdValues(self, nums, queries):
        """
        :type nums: List[int]
        :type queries: List[int]
        :rtype: List[int]
        """
        maxv = max(nums)

        # Frequency of each value
        freq = [0] * (maxv + 1)
        for x in nums:
            freq[x] += 1

        # cnt[d] = numbers divisible by d
        cnt = [0] * (maxv + 1)
        for d in range(1, maxv + 1):
            for m in range(d, maxv + 1, d):
                cnt[d] += freq[m]

        # exact[d] = pairs with gcd exactly d
        exact = [0] * (maxv + 1)
        for d in range(maxv, 0, -1):
            c = cnt[d]
            exact[d] = c * (c - 1) // 2
            m = d * 2
            while m <= maxv:
                exact[d] -= exact[m]
                m += d

        # Prefix counts of sorted gcd values
        prefix = [0] * (maxv + 1)
        for d in range(1, maxv + 1):
            prefix[d] = prefix[d - 1] + exact[d]

        ans = []
        for q in queries:
            q += 1  # convert to 1-based order statistic

            lo, hi = 1, maxv
            while lo < hi:
                mid = (lo + hi) // 2
                if prefix[mid] >= q:
                    hi = mid
                else:
                    lo = mid + 1

            ans.append(lo)

        return ans
