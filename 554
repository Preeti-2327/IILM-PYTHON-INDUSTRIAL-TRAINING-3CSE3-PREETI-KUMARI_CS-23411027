class Solution(object):
    def leastBricks(self, wall):
        """
        :type wall: List[List[int]]
        :rtype: int
        """
        edge_count = {}

        for row in wall:
            pos = 0
            # Exclude the last brick to avoid drawing on the wall's edge
            for brick in row[:-1]:
                pos += brick
                edge_count[pos] = edge_count.get(pos, 0) + 1

        max_edges = 0
        for count in edge_count.values():
            if count > max_edges:
                max_edges = count

        return len(wall) - max_edges
