class Solution(object):
    def arrayNesting(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = len(nums)
        visited = [False] * n
        ans = 0

        for i in range(n):
            if not visited[i]:
                count = 0
                j = i

                while not visited[j]:
                    visited[j] = True
                    j = nums[j]
                    count += 1

                ans = max(ans, count)

        return ans
