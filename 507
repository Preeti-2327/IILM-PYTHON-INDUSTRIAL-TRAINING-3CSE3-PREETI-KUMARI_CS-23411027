import math

class Solution(object):
    def checkPerfectNumber(self, num):
        """
        :type num: int
        :rtype: bool
        """
        if num == 1:
            return False

        total = 1
        limit = int(math.sqrt(num))

        for i in range(2, limit + 1):
            if num % i == 0:
                total += i
                if i != num // i:
                    total += num // i

        return total == num
