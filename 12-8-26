class Solution(object):
    def maxSubarrayLength(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        freq = {}
        left = 0
        ans = 0

        for right in range(len(nums)):
            freq[nums[right]] = freq.get(nums[right], 0) + 1

            # Window is invalid
            while freq[nums[right]] > k:
                freq[nums[left]] -= 1
                left += 1

            # Current window is good
            ans = max(ans, right - left + 1)

        return ans
