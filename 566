class Solution(object):
    def matrixReshape(self, mat, r, c):
        """
        :type mat: List[List[int]]
        :type r: int
        :type c: int
        :rtype: List[List[int]]
        """
        m = len(mat)
        n = len(mat[0])

        if m * n != r * c:
            return mat

        ans = [[0] * c for _ in range(r)]

        for i in range(m):
            for j in range(n):
                index = i * n + j

                new_i = index // c
                new_j = index % c

                ans[new_i][new_j] = mat[i][j]

        return ans
