class Solution(object):
    def subarraySum(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        count = 0
        prefix_sum = 0

        # prefix_sum -> number of times it has appeared
        freq = {0: 1}

        for num in nums:
            prefix_sum += num

            # If previous prefix sum was prefix_sum - k,
            # then the subarray between them has sum k.
            if prefix_sum - k in freq:
                count += freq[prefix_sum - k]

            freq[prefix_sum] = freq.get(prefix_sum, 0) + 1

        return count
