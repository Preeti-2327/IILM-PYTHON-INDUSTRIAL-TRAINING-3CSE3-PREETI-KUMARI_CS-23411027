class Solution(object):
    def largestPalindrome(self, n):
        """
        :type n: int
        :rtype: int
        """
        if n == 1:
            return 9

        upper = 10 ** n - 1
        lower = 10 ** (n - 1)

        for left in range(upper, lower - 1, -1):
            s = str(left)
            pal = int(s + s[::-1])

            x = upper
            while x * x >= pal:
                if pal % x == 0:
                    y = pal // x
                    if lower <= y <= upper:
                        return pal % 1337
                x -= 1
