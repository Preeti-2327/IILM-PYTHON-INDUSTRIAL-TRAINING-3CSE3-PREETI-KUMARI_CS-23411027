class Solution(object):
    def arrayRankTransform(self, arr):
        """
        :type arr: List[int]
        :rtype: List[int]
        """
        rank = {}

        # Assign ranks to unique sorted elements
        for i, num in enumerate(sorted(set(arr)), 1):
            rank[num] = i

        # Replace each element with its rank
        return [rank[num] for num in arr]
