class Solution(object):
    def countArrangement(self, n):
        """
        :type n: int
        :rtype: int
        """
        memo = {}

        def dfs(pos, mask):
            if pos > n:
                return 1

            if (pos, mask) in memo:
                return memo[(pos, mask)]

            ans = 0

            for num in range(1, n + 1):
                if not (mask & (1 << (num - 1))):
                    if num % pos == 0 or pos % num == 0:
                        ans += dfs(pos + 1, mask | (1 << (num - 1)))

            memo[(pos, mask)] = ans
            return ans

        return dfs(1, 0)
