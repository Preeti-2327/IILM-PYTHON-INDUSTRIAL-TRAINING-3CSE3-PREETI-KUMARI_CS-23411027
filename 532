from collections import Counter

class Solution(object):
    def findPairs(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        if k < 0:
            return 0

        freq = Counter(nums)
        ans = 0

        if k == 0:
            for x in freq:
                if freq[x] > 1:
                    ans += 1
        else:
            for x in freq:
                if x + k in freq:
                    ans += 1

        return ans
