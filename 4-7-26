class Solution(object):
    def minScore(self, n, roads):
        """
        :type n: int
        :type roads: List[List[int]]
        :rtype: int
        """
        from collections import defaultdict

        graph = defaultdict(list)

        for u, v, d in roads:
            graph[u].append((v, d))
            graph[v].append((u, d))

        visited = set()
        ans = float('inf')

        stack = [1]

        while stack:
            node = stack.pop()
            if node in visited:
                continue
            visited.add(node)

            for nei, dist in graph[node]:
                ans = min(ans, dist)
                if nei not in visited:
                    stack.append(nei)

        return ans
